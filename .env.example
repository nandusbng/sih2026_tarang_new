# TARANG – Unified Maritime AI Platform
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# No secret below may be hardcoded into source, and no service-role key may
# ever reach the browser.

# --- Supabase (authoritative database) -------------------------------------
# Project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=your_supabase_project_url

# Publishable / anon key. Safe for client-side use; must still live only in
# the environment, not in source.
SUPABASE_KEY=your_supabase_publishable_key
# Accepted alias for SUPABASE_KEY.
SUPABASE_ANON_KEY=your_supabase_publishable_key

# BACKEND ONLY — service-role key bypasses Row Level Security. It is used
# server-side for storage round-trips and diagnostics and must never be sent
# to the browser or logged.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# --- Flask server ----------------------------------------------------------
PORT=3000
# Signs demo-session tokens. Use a long random string; without it signed demo
# access cannot be verified.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Public base URL of this backend, used by self-probes and verification
# scripts. Leave the default for local development.
TARANG_BACKEND_URL=http://localhost:3000

# --- Demo access -----------------------------------------------------------
# Lifetime in seconds of a signed demo portal session.
TARANG_DEMO_SESSION_SECONDS=3600

# --- Upload / processing ---------------------------------------------------
# Maximum frames sampled from an uploaded video. Video is sampled, not decoded
# frame by frame, so a long survey video stays affordable in one request. The
# response reports how many of the total frames were actually analysed.
TARANG_VIDEO_MAX_FRAMES=12

# --- System status diagnostics ---------------------------------------------
# Storage bucket used by the read/write/delete status probe. It must be a
# bucket the service key can write to; image MIME types are required because
# the probe uploads a real PNG.
TARANG_STATUS_BUCKET=survey-images
# Per-probe HTTP timeout in seconds.
TARANG_STATUS_TIMEOUT=12
